<?xml version="1.0"?>
<config>
    <tabs>
        <mageaustralia translate="label" module="mageaustralia_pdf">
            <label>Mage Australia</label>
            <sort_order>400</sort_order>
        </mageaustralia>
    </tabs>
    <sections>
        <mageaustralia_pdf translate="label" module="mageaustralia_pdf">
            <label>Invoice PDF</label>
            <tab>mageaustralia</tab>
            <sort_order>10</sort_order>
            <show_in_default>1</show_in_default>
            <show_in_website>1</show_in_website>
            <show_in_store>1</show_in_store>
            <groups>
                <general translate="label">
                    <label>General</label>
                    <sort_order>10</sort_order>
                    <show_in_default>1</show_in_default>
                    <show_in_website>1</show_in_website>
                    <show_in_store>1</show_in_store>
                    <fields>
                        <enabled translate="label">
                            <label>Enabled</label>
                            <frontend_type>select</frontend_type>
                            <source_model>adminhtml/system_config_source_yesno</source_model>
                            <sort_order>10</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                        </enabled>
                        <logo translate="label comment">
                            <label>Logo</label>
                            <frontend_type>image</frontend_type>
                            <backend_model>adminhtml/system_config_backend_image</backend_model>
                            <upload_dir config="system/filesystem/media" scope_info="1">mageaustralia/pdf</upload_dir>
                            <base_url type="media" scope_info="1">mageaustralia/pdf</base_url>
                            <comment>PNG/JPG shown top-left of the invoice.</comment>
                            <sort_order>20</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                        </logo>
                        <store_name translate="label">
                            <label>Store Name</label>
                            <frontend_type>text</frontend_type>
                            <sort_order>30</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                        </store_name>
                        <store_address translate="label comment">
                            <label>Store Address</label>
                            <frontend_type>textarea</frontend_type>
                            <comment>Free text, shown under the store name (one line per row).</comment>
                            <sort_order>40</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                        </store_address>
                        <abn translate="label">
                            <label>ABN</label>
                            <frontend_type>text</frontend_type>
                            <sort_order>50</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                        </abn>
                        <bank_details translate="label comment">
                            <label>Bank Details (footer)</label>
                            <frontend_type>textarea</frontend_type>
                            <comment>Free text, shown in the footer (one line per row).</comment>
                            <sort_order>60</sort_order>
                            <show_in_default>1</show_in_default>
                            <show_in_website>1</show_in_website>
                            <show_in_store>1</show_in_store>
                        </bank_details>
                    </fields>
                </general>
            </groups>
        </mageaustralia_pdf>
    </sections>
</config>
